@inject NavigationManager Nav
@rendermode InteractiveServer
@code {
    [Parameter]
    public string ButtonText { get; set; } = string.Empty;
    [Parameter]
    public string ButtonTextColor { get; set; } = string.Empty;
    [Parameter]
    public string ButtonColor { get; set; } = string.Empty; 
    [Parameter]
    public bool ButtonShadow { get; set; } = false;
    [Parameter]
    public string ButtonUrlImage { get; set; } = string.Empty;
    [Parameter]
    public EventCallback OnClick { get; set; }
    [Parameter]
    public string? NavigateUrl { get; set; }

    private async Task HandleClick()
    {

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }

        else if (!string.IsNullOrEmpty(NavigateUrl))
        {
            Nav.NavigateTo(NavigateUrl);
        }
    }

}

<button class="py-1 navbar-option-scrollY border-0 rounded-3 px-3 d-flex align-items-center justify-content-center" style="text-wrap: nowrap; background-color: @ButtonColor; color: @ButtonTextColor;" @onclick="HandleClick" >
    @if (!String.IsNullOrEmpty(ButtonUrlImage))
    {
        <img src="@ButtonUrlImage"/>
    }
    <div>
    @ButtonText</div>
</button>