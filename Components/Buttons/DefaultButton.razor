
@code {
    [Parameter]
    public string ButtonText { get; set; } = string.Empty;
    [Parameter]
    public string ButtonTextColor { get; set; } = string.Empty;
    [Parameter]
    public string ButtonColor { get; set; } = string.Empty; //Passe um padrão que o css aceite, HEX ou RGB;
    [Parameter]
    public bool ButtonShadow { get; set; } = false;
    [Parameter]
    public string ButtonImage { get; set; } = string.Empty;
}

<button class="py-1 border-0 rounded-3 px-3 d-flex align-items-center justify-content-center"
style="
    color: @ButtonTextColor;
    background-color: @ButtonColor;
    width:130px;
    text-wrap: nowrap;"
>@ButtonText</button>