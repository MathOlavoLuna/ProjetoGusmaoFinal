@code{
    [Parameter]
    public string UrlImage { get;set; } = string.Empty;
    [Parameter]
    public string SummaryText { get; set; } = string.Empty;
    [Parameter]
    public string Title { get; set; } = string.Empty;
}

<div class="card border-1 card-news-container d-flex align-items-center">
    <div class="card-img">
        <img src="@UrlImage"/>
    </div>
    <div class="card-title">@Title</div>
    <div class="card-body" style="max-height:298px; overflow-y: auto;">
        @SummaryText
    </div>
    <btn class="btn-info text-decoration-none card-news-button text-center">Saiba Mais</btn>
</div>
<style>
    .card-news-container{
        width:350px;
        height: 440px;
        padding: 25px;
    }

    .card-news-button{
        color: white;
        padding: 5px;
        border-radius: 20px;
        width: 150px;
        background-color: #EAC556;
    }
</style>