@rendermode InteractiveServer
@inject NavigationManager Nav

@code {
    private void HandleLogout()
    {
        Nav.NavigateTo("/logout", true);
    }

    private void NavigateToHome()
    {
        Nav.NavigateTo("/");
    }

    private void NavigateToMatricula()
    {
        Nav.NavigateTo("/Matricula");
    }
}

<link href="header.css" rel="stylesheet" />
<div class="row p-4 header-navbar bg-white position-fixed w-100 text-white m-0 ">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <img class="navbar-logo" src="images/LogoGusmão.png" />
            <span class="text-dark fs-4" style="font-weight:700;" id="navbar-title">GUSMÃO</span>
        </div>
        <div class="d-flex gap-3">
            <button type="button" @onclick="NavigateToHome" class="py-1 border-1 rounded-3 px-3 navbar-option navbar-option-class d-flex align-items-center justify-content-center border-0">HOME</button>
            <button type="button" @onclick="NavigateToHome" class="py-1 border-1 rounded-3 px-3 navbar-option navbar-option-class d-flex align-items-center justify-content-center border-0">NÓTICIAS</button>
            <button type="button" @onclick="NavigateToMatricula" class="py-1 border-1 rounded-3 px-3 navbar-option navbar-option-class d-flex align-items-center justify-content-center border-0">MATRÍCULA</button>
        </div>
        <button type="button" @onclick="HandleLogout" class="py-1 border-1 rounded-3 px-3 navbar-option navbar-option-class d-flex align-items-center justify-content-center border-0">SAIR</button>
    </div>
</div>

<style>
    .header-navbar {
        z-index: 9999;
        animation: ease-in-out;
        transition: 0.9s;
    }

    .navbar-option-class {
        cursor: pointer;
    }
</style>

<script>
    (function() {
        // Remove event listeners antigos se existirem
        if (window.navbarScrollHandler) {
            window.removeEventListener('scroll', window.navbarScrollHandler);
        }

        const NavBar = document.querySelector('.header-navbar');
        const NavBarButtons = document.getElementsByClassName('navbar-option-class');
        const NavBarTitle = document.getElementById('navbar-title');

        // Verifica se está na página de Matrícula
        const isMatriculaPage = () => window.location.pathname.includes('/Matricula' || '/Noticia');

        window.navbarScrollHandler = function() {
            if (isMatriculaPage()) {
                for (let i = 0; i < NavBarButtons.length; i++) {
                    NavBarButtons[i].classList.add('navbar-option');
                    NavBarButtons[i].classList.remove('navbar-option-scrollY');
                }
                if (NavBarTitle) {
                    NavBarTitle.classList.remove('navbar-title-scrollY');
                }
                return;
            }

            // Lógica do background do navbar
            if (window.scrollY > 350) {
                if (NavBar) NavBar.classList.add('header-navbar-scroll');
            } else {
                if (NavBar) NavBar.classList.remove('header-navbar-scroll');
            }

            // Lógica normal para outras páginas
            for (let i = 0; i < NavBarButtons.length; i++) {
                const Btn = NavBarButtons[i];

                if (window.scrollY > 350) {
                    if (NavBarTitle) NavBarTitle.classList.add('navbar-title-scrollY');
                    Btn.classList.remove('navbar-option');
                    Btn.classList.add('navbar-option-scrollY');
                } else {
                    Btn.classList.add('navbar-option');
                    Btn.classList.remove('navbar-option-scrollY');
                    if (NavBarTitle) NavBarTitle.classList.remove('navbar-title-scrollY');
                }
            }
        };

        window.addEventListener('scroll', window.navbarScrollHandler);
    })();
</script>

