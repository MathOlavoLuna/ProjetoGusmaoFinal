@page "/Login"
@using System.Security.Claims;
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using System.ComponentModel.DataAnnotations
@inject Services.UserService _userService;
@attribute [AllowAnonymous]
@inject NavigationManager Nav

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private LoginForm Model { get; set; } = new();

    void RedirectToSignUp()
    {
        Nav.NavigateTo("/SignUp");
    }

    private async Task HandleLogin(EditContext editContext)
    {
        try
        {
            ApiResponse<Users> Response = await _userService.GetUser(Model.Email, Model.Password);
            if (Response.Success)
            {
                List<Claim> claims = new()
            {
                new Claim(ClaimTypes.NameIdentifier, Response.Data[0].Id.ToString()),
                new Claim(ClaimTypes.Name, Response.Data[0].Name),
                new Claim(ClaimTypes.Role, Response.Data[0].Role?.Name ?? "DEFAULT ROLE")
            };

                ClaimsIdentity claimsIdentity = new(claims, "CookieAuth");
                ClaimsPrincipal claimsPrincipal = new(claimsIdentity);

                await HttpContext!.SignInAsync("CookieAuth", claimsPrincipal);

                Nav.NavigateTo("/");
            }
            else
            {
                var messageStore = new ValidationMessageStore(editContext);

                if (Response.Message.Contains("Senha"))
                {
                    messageStore.Add(editContext.Field(nameof(Model.Password)), Response.Message);
                }
                else
                {
                    messageStore.Add(editContext.Field(nameof(Model.Email)), Response.Message);
                }

                editContext.NotifyValidationStateChanged();
            }
        }
        catch (NavigationException)
        {
            Nav.NavigateTo("/", true);
        }
        catch (Exception)
        {
            var messageStore = new ValidationMessageStore(editContext);
            messageStore.Add(editContext.Field(nameof(Model.Email)), "Erro ao fazer login. Tente novamente.");
            editContext.NotifyValidationStateChanged();
        }
    }

    public class LoginForm
    {
        [Required(ErrorMessage = "Email é obrigatório")]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Senha é obrigatória")]
        public string Password { get; set; } = string.Empty;
    }
}

<div class="container-fluid" id="container-login">
    <div class="container d-flex justify-content-evenly align-items-center min-vh-100 flex-column">
        <div class="row">
            <h1>GUSMÃO BRITTO</h1>
        </div>
        <div class="row align-items-center justify-content-center p-2 w-75  rounded-end-4 border border-start-0 border-top-0 border-bottom-0">
            <div class="col-12 col-lg-6">
                <div class="rounded-start-4" id="img-login">
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <EditForm Model="@Model" class="d-flex justify-content-between flex-column" FormName="LoginForm" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" type="email" @bind-Value="Model.Email" />
                        <ValidationMessage For="@(() => Model.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <InputText class="form-control" type="password" @bind-Value="Model.Password" />
                        <ValidationMessage For="@(() => Model.Password)" />
                    </div>
                            <label class="form-check-label" for="exampleCheck1">Mantenha-se conectado</label>
                    
                    <div class="mb-3">
                        <button class="btn btn-primary">Login</button>
                    </div>
                    <ul>
                        <li>
                            <span>
                                Não tem conta? <a href="/SignUp" class="btn btn-link"
                                                    @onclick="RedirectToSignUp"
                                                    @onclick:preventDefault>
                                    cadastre-se
                                </a>
                            </span>
                        </li>
                        <li><span><a>Esqueci minha senha</a></span></li>
                    </ul>
                </EditForm>
            </div>
        </div>
    </div>
    
   
</div>
<style>
    #img-login{
        min-width:350px;
        min-height:400px;
        background-image:url('images/Gusmão Frente.png') !important;
        background-repeat:no-repeat;
        background-size:cover;
    }
    #form-card{
        backdrop-filter: blur(14px);
    }
</style>