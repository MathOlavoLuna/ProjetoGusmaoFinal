@page "/Login"
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject NavigationManager Nav

@code{
    LoginForm Model = new();
    void RedirectToSignUp()
    {
        Nav.NavigateTo("/SignUp");
    }

    private async Task HandleLogin()
    {

    }

    public class LoginForm
    {
        public string Email { get; set; }
        public string Password { get; set; }
    }
}

<div class="container-fluid" id="container-login">
    <div class="container d-flex justify-content-evenly align-items-center min-vh-100 flex-column">
        <div class="row">
            <h1>GUSMÃO BRITTO</h1>
        </div>
        <div class="row align-items-center justify-content-center p-2 w-75  rounded-end-4 border border-start-0 border-top-0 border-bottom-0">
            <div class="col-12 col-lg-6">
                <div class="rounded-start-4" id="img-login">
                </div>
            </div>
            <div class="col-12 col-lg-6">
                <EditForm Model="Model" class="d-flex justify-content-between flex-column" id="form-card" FormName="LoginForm" OnValidSubmit="HandleLogin">
                    
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" type="email" @bind-Value="Model.Email" />
                    <ValidationMessage For="@(() => Model.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <InputText class="form-control" type="password" @bind-Value="Model.Password" />
                    <ValidationMessage For="@(() => Model.Password)" />
                </div>
                        <label class="form-check-label" for="exampleCheck1">Mantenha-se conectado</label>
                    
                    <div class="mb-3">
                        <button class="btn btn-primary">Login</button>
                    </div>
                    <ul>
                        <li>
                            <span>
                                Não tem conta? <a href="/SignUp" class="btn btn-link"
                                                    @onclick="RedirectToSignUp"
                                                    @onclick:preventDefault>
                                    cadastre-se
                                </a>
                            </span>
                        </li>
                        <li><span><a>Esqueci minha senha</a></span></li>
                    </ul>
                </EditForm>
            </div>
        </div>
    </div>
    
   
</div>
<style>
    #img-login{
        min-width:350px;
        min-height:400px;
        background-image:url('images/Gusmão Frente.png') !important;
        background-repeat:no-repeat;
        background-size:cover;
    }
    #form-card{
        backdrop-filter: blur(14px);
    }
</style>