@page "/Login"
<!DOCTYPE html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
</head>
   
<div class="container d-flex justify-content-evenly align-items-center min-vh-100 flex-column">
    <div class="row">
        <h1>GUSMÃO BRITTO</h1>
    </div>
    <div class="row">
        <div class="col-12">
            <form class="border border-1 rounded-3 p-2">
                <div class="mb-3">
                    <label for="exampleInputEmail1" class="form-label">Email</label>
                    <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                    <div id="emailHelp" class="form-text">Não compartilhamos seu e-mail com mais ninguém.</div>
                </div>
                <div class="mb-3">
                    <label for="exampleInputPassword1" class="form-label">Senha</label>
                    <input type="password" class="form-control" id="exampleInputPassword1">
                </div>
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="exampleCheck1">
                    <label class="form-check-label" for="exampleCheck1">Mantenha-se conectado</label>
                </div>
                <button type="submit" class="btn btn-primary">Login</button>

                <ul>
                    <li><span>Não tem conta? <a>cadastre-se</a></span></li>
                    <li><span><a>Esqueci minha senha</a></span></li>
                </ul>               
            </form>
        </div>
    </div>
</div>
