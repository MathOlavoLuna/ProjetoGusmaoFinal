@page "/SignUp"
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ProjetoGusmaoFinal.Services.UserService UserService
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<ProjetoGusmaoFinal.Components.Toasts.DefaultToast Success=@Success Message=@Message TimeActived="2000" />

<EditForm Model="@Model" OnValidSubmit="HandleSubmit" FormName="SignUpForm">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="container d-flex justify-content-evenly align-items-center min-vh-100 flex-column">
        <div class="row">
            <h1>Cadastre-se</h1>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="border border-1 rounded-3 p-3" style="min-width: 350px;">
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <InputText class="form-control" @bind-Value="Model.Name" />
                        <ValidationMessage For="@(() => Model.Name)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Sobrenome</label>
                        <InputText class="form-control" @bind-Value="Sobrenome" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" type="email" @bind-Value="Model.Email" />
                        <ValidationMessage For="@(() => Model.Email)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <InputText class="form-control" type="password" @bind-Value="Model.Password" />
                        <ValidationMessage For="@(() => Model.Password)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">CPF</label>
                        <InputText class="form-control" @bind-Value="Model.CPF" />
                        <ValidationMessage For="@(() => Model.CPF)" />
                    </div>

                    <div class="mb-3 form-check">
                        <InputCheckbox class="form-check-input" @bind-Value="Conectado" />
                        <label class="form-check-label">Mantenha-se conectado</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Cadastrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    // Toast Parameters Section
    private string Message = string.Empty;
    private bool Success = false;

    [SupplyParameterFromForm]
    private SignUpViewModel Model { get; set; } = new();

    [SupplyParameterFromForm]
    private string Sobrenome { get; set; } = string.Empty;

    [SupplyParameterFromForm]
    private bool Conectado { get; set; } = false;

    private HashResponse PassHashed = new();

    private async Task HandleSubmit()
    {
        // Limpa mensagens anteriores
        Message = string.Empty;
        StateHasChanged();

        PassHashed = HashService.Crypt(Model.Password);
        if (PassHashed.Success) Model.Password = PassHashed.Hash;

        if (!string.IsNullOrWhiteSpace(Sobrenome))
        {
            Model.Name += $" {Sobrenome}";
        }

        Users NewUser = new()
        {
            Name = Model.Name,
            Email = Model.Email,
            Password = Model.Password,
            CPF = Model.CPF
        };

        ApiResponse<Users> Response = await UserService.PostUser(NewUser);

        if (Response.Success)
        {
            Success = true;
            Message = "Operação realizada com sucesso!";
        }
        else
        {
            Success = false;
            Message = "Ocorreu um erro ao processar a ação.";
        }

        // Força atualização da UI
        StateHasChanged();
    }

    public class SignUpViewModel
    {
        [Required(ErrorMessage = "Nome é obrigatório")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email é obrigatório")]
        [EmailAddress(ErrorMessage = "Email inválido")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Senha é obrigatória")]
        [MinLength(6, ErrorMessage = "Senha deve ter no mínimo 6 caracteres")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "CPF é obrigatório")]
        public string CPF { get; set; } = string.Empty;
    }
}
