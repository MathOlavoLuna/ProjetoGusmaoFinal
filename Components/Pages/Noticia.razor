@page "/Noticia"

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ProjetoGusmaoFinal.Services.UserService UserService
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <EditForm Model="@Model" FormName="NewsCreate" class="w-100 d-flex justify-content-center">
        <DataAnnotationsValidator />
        <div class="row w-50 border border-1 rounded-4 border-black p-2 justify-content-center">
            <div class="row justify-content-between">
                <div class="w-50">Criar Nóticia</div> <button class="w-25">Criar</button>
            </div>
            <div class="row gap-1">
                <label class="form-label" for="Titulo">Título</label>
                <InputText id="Titulo" class="form-control m-0" type="text" @bind-Value="Model.Title" />
                <label class="form-label" for="Conteudo">Conteúdo</label>
                <InputTextArea id="Conteudo"  class="form-control" @bind-Value ="Model.ConteudoEscrito" style="max-height:200px; height:200px;"></InputTextArea>
            </div>
        </div>
    </EditForm>
</div>
@code {
    [SupplyParameterFromForm]
    private NewsCreate Model { get; set; } = new();

    private class NewsCreate
    {
        public string Title { get; set; } = string.Empty;
        public string ConteudoEscrito { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; } = DateTime.Now;
        public int UserId { get; set; }
    }
}
